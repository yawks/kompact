    <string name="kompact_is_an_offline_file_compressor_designed_to_run_entirely_on_device_your_files_never_leave_your_phone_ensuring_complete_privacy">Kompact là một trình nén tệp ngoại tuyến được thiết kế để chạy hoàn toàn trên thiết bị. Các tập tin của bạn không bao giờ rời khỏi điện thoại của bạn, đảm bảo sự riêng tư hoàn toàn.</string>
    <string name="current_features">Tính năng hiện tại</string>
    <string name="precision_compression_target_specific_file_sizes_or_quality_percentages_n">• Nén chính xác: Nhắm mục tiêu kích thước tệp hoặc phần trăm chất lượng cụ thể.\n</string>
    <string name="roadmap">Lộ trình</string>
    <string name="we_are_working_to_make_kompact_the_ultimate_optimizer_future_updates_will_bring_support_for_pdf_documents_audio_tracks_and_video_files">Chúng tôi đang nỗ lực để biến Kompact thành trình tối ưu hóa tối ưu. Các bản cập nhật trong tương lai sẽ mang đến sự hỗ trợ cho các tài liệu PDF, bản âm thanh và tệp Video.</string>
    <string name="open_source">Nguồn mở</string>
    <string name="this_project_is_open_source_under_the_apache_2_0_license_you_can_inspect_the_code_report_issues_or_contribute_on_our_repository">Dự án này là nguồn mở theo giấy phép Apache 2.0. Bạn có thể kiểm tra mã, báo cáo sự cố hoặc đóng góp trên kho lưu trữ của chúng tôi.</string>
    <string name="visit_repository">Truy cập kho lưu trữ</string>
    <string name="support_development">Hỗ trợ phát triển</string>
    <string name="a_personal_note">Ghi chú cá nhân</string>
    <string name="i_built_kompact_because_i_believe_essential_tools_should_be_simple_private_and_free_of_ads_or_tracking_i_work_on_this_in_my_spare_time_driven_by_the_idea_of_making_a_useful_utility_for_everyone">Tôi xây dựng Kompact vì tôi tin rằng các công cụ thiết yếu phải đơn giản, riêng tư và không có quảng cáo hoặc theo dõi. Tôi làm việc này trong thời gian rảnh rỗi, được thúc đẩy bởi ý tưởng tạo ra một tiện ích hữu ích cho mọi người.</string>
    <string name="support">Hỗ trợ</string>
    <string name="if_kompact_has_saved_you_space_or_time_please_consider_supporting_its_development_your_donation_directly_helps_me_dedicate_more_hours_to_adding_features_like_pdf_audio_and_video_support_and_keeps_the_project_independent_and_sustainable">Nếu Kompact đã giúp bạn tiết kiệm không gian hoặc thời gian, vui lòng xem xét hỗ trợ sự phát triển của nó. Khoản quyên góp của bạn trực tiếp giúp tôi dành nhiều thời gian hơn để bổ sung các tính năng như hỗ trợ PDF, Âm thanh và Video, đồng thời giữ cho dự án luôn độc lập và bền vững.</string>
