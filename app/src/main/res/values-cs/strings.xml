    <string name="kompact_is_an_offline_file_compressor_designed_to_run_entirely_on_device_your_files_never_leave_your_phone_ensuring_complete_privacy">Kompact je offline souborový kompresor navržený tak, aby fungoval výhradně na zařízení. Vaše soubory nikdy neopustí váš telefon, což zajišťuje naprosté soukromí.</string>
    <string name="current_features">Aktuální funkce</string>
    <string name="precision_compression_target_specific_file_sizes_or_quality_percentages_n">• Přesná Komprese: Zaměřte se na konkrétní velikosti souborů nebo procenta kvality.&#10;• Inteligentní Úpravy: Ořízněte obrázky, spravujte metadata EXIF, změňte velikost, otáčejte, aplikujte barevné filtry a přidejte textové overlay.&#10;</string>
    <string name="roadmap">Plán</string>
    <string name="we_are_working_to_make_kompact_the_ultimate_optimizer_future_updates_will_bring_support_for_pdf_documents_audio_tracks_and_video_files">Podpora pro video, PDF a audio je plánována pro budoucí verze.</string>
    <string name="open_source">Open source</string>
    <string name="this_project_is_open_source_under_the_apache_2_0_license_you_can_inspect_the_code_report_issues_or_contribute_on_our_repository">Tento projekt je open source pod licencí AGPL 3.0. Můžete si prohlédnout kód, nahlásit problémy nebo přispět do našeho repozitáře.</string>
    <string name="visit_repository">Navštivte úložiště</string>
